{
  "name": "tunestudio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter @tunestudio/studio",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.1",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-solid": "^0.18.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "turbo": "^2.11.8"
  },
  "packageManager": "bun@1.3.14"
}
