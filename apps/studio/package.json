{
  "name": "@tunestudio/studio",
  "version": "0.1.0",
  "private": true,
  "description": "UltraStar chart editor",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:vite": "vite",
    "build": "vite build && bun run build:electron && bun run native:build:release",
    "build:vite": "vite build",
    "build:electron": "bun scripts/build-electron.ts",
    "native:build": "bun scripts/native.ts",
    "native:build:release": "bun scripts/native.ts --release",
    "native:test": "cargo test --manifest-path native/Cargo.toml --release --lib",
    "package": "bun scripts/package.ts",
    "package:dir": "bun scripts/package.ts --dir",
    "start": "bun scripts/start.ts",
    "typecheck": "tsr generate && tsc --noEmit -p electron/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "shots": "node e2e/shots.ts",
    "db:generate": "drizzle-kit generate && bun scripts/bundle-migrations.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.4",
    "@effect/sql-sqlite-node": "4.0.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@solidjs/web": "2.0.0-rc.15",
    "@tanstack/solid-router": "2.0.0-rc.8",
    "@tunestudio/ultrastar": "workspace:*",
    "base-ui-solid": "0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "4.0.4",
    "solid-js": "2.0.0-rc.15",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.4",
    "@electron/fuses": "^1.8.0",
    "@iconify-json/lucide": "^1.2.144",
    "@napi-rs/cli": "^3.10.5",
    "@playwright/test": "^1.64.1",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "1.167.43",
    "@tanstack/router-plugin": "1.168.45",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "napi": {
    "binaryName": "tunestudio-native"
  },
  "productName": "Tune Studio"
}
